# Local secrets and runtime state
.env
.env.deploy
.env.deploy.*
# Local deployment inventory may contain plaintext host credentials.
envirment.xlsx
.env.deploy.lock
.env.*
!.env.deploy.example
*.env
web/.env.local
web/.env.*.local
# Foundry's ad-hoc solc output when deployment helpers are run outside
# `forge build`; canonical artifacts live under `out/`.
/*_sol_*.bin
agents.json
sessions.sqlite3
*.sqlite3
*.sqlite3-shm
*.sqlite3-wal

# Codex and tunnel runtime data
.codex-gateway-home/
.codex-run/
/.mycomesh/

# Python cache and virtual environments
__pycache__/
*.py[cod]
.venv/
venv/

# Foundry build output
out/
cache/
broadcast/

# Local editor and OS files
.DS_Store
/-

# MycoMesh web build and browser-test output
web/node_modules/
packages/mycomesh-cli/node_modules/
web/dist/
web/playwright-report/
web/test-results/
web/*.tsbuildinfo

# Generated local release artifacts and historical run outputs. These stay
# available in a checkout for local inspection but are never part of a source
# release or deployment image.
/artifacts/
/rendered*/
/~$*
deployments/*.pre-*
packages/mycomesh-cli/networks/*.pre-*
*.before-ip-mesh

# One-off document-generation helpers and customer deliverables are outside
# the MycoMesh source release.
/create_doc.py
/create_pdf.py
/客户需求应答函_海外AI视频模型账号与充值服务.docx
/客户需求应答函_海外AI视频模型账号与充值服务.pdf
