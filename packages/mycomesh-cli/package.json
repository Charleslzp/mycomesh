{
  "name": "mycomesh-consumer",
  "version": "0.7.0",
  "description": "MycoMesh V11 Consumer: a custodied deposit, relay-blind encrypted requests to any Provider, and a local OpenAI-compatible endpoint.",
  "repository": {
    "type": "git",
    "url": "https://github.com/Charleslzp/mycomesh"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "bin": {
    "mycomesh-consumer": "bin/mycomesh-consumer.mjs"
  },
  "files": [
    "bin/mycomesh-consumer.mjs",
    "src/*.mjs",
    "src/web/*.html",
    "networks/mycomesh-v11-sepolia.json",
    "networks/mycomesh-testnet-ca.crt",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@noble/curves": "1.9.1",
    "@noble/hashes": "1.8.0"
  },
  "scripts": {
    "test": "node --test test/*.test.mjs"
  },
  "license": "UNLICENSED"
}
