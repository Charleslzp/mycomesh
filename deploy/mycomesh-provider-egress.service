[Unit]
Description=MycoMesh Provider outbound Trojan proxy
Wants=network-online.target
After=network-online.target docker.service

[Service]
Type=simple
ExecStart=/usr/local/bin/mycomesh-sing-box run -c /etc/mycomesh/provider-egress.json
Restart=always
RestartSec=5
User=root
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
ReadOnlyPaths=/etc/mycomesh/provider-egress.json

[Install]
WantedBy=multi-user.target
